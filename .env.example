# ============ 基础设施 ============
# PostgreSQL（任务持久化 + LangGraph checkpointer）
PG_DSN=postgresql+psycopg://ec:ec@postgres:5432/ecagent

# MinIO（商品图片素材存储）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS=minioadmin
MINIO_SECRET=minioadmin
MINIO_SECURE=false

# 浏览器是否无头（容器内必须 true）
HEADLESS=true

# ============ 飞书应用 ============
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_APP_TOKEN=bascnxxxxxxxxxxxxxxxxxx
FEISHU_TABLE_TASK=tblxxxxxxxx
FEISHU_TABLE_SKU=tblyyyyyyyy
FEISHU_TABLE_LOG=tblzzzzzzzz
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxx
FEISHU_OPERATOR_ID=ou_xxxxxxxxxxxxxxxx

# ============ 代理配置（可选）============
PROXY_SERVER=http://your-proxy-server:8080
PROXY_USER=your_proxy_user

# ============ 店铺账号 ============
# 淘宝
TAOBAO_ACCOUNT=your_taobao_account
TAOBAO_PWD=your_taobao_password
TAOBAO_PROXY_PWD=

# 拼多多
PDD_ACCOUNT=your_pdd_account
PDD_PWD=your_pdd_password
PDD_PROXY_PWD=

# 抖音
DOUYIN_ACCOUNT=your_douyin_account
DOUYIN_PWD=your_douyin_password
DOUYIN_PROXY_PWD=

# 京东
JD_ACCOUNT=your_jd_account
JD_PWD=your_jd_password
JD_PROXY_PWD=

# ============ Worker 模式 ============
# worker 容器绑定单个店铺（单店铺单容器隔离）
TARGET_SHOP=shop_taobao